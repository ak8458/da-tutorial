<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Article Index</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    body { font-family: Arial, sans-serif; margin: 2rem; }
    h1 { margin-bottom: 1rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(280px,1fr)); gap: 1rem; }
    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; background:#fff; display:flex; flex-direction:column; }
    .card img { max-width:100%; height:auto; border-radius:4px; margin-bottom:.5rem; }
    .meta { font-size: .75rem; color:#555; margin-top:auto; }
    .title { font-size:1rem; font-weight:600; margin:0 0 .25rem; }
    .desc { font-size:.85rem; color:#333; margin:0 0 .5rem; }
    .tagline { font-size:.7rem; color:#777; }
    a.card-link { text-decoration:none; color:inherit; }
  </style>
</head>
<body>
  <h1>Article Index</h1>
  <div class="grid">
    {{#data}}
    <a class="card-link" href="{{url}}">
      <div class="card">
        {{#image}}
        <img src="{{image}}" alt="{{title}}" loading="lazy" />
        {{/image}}
        <h2 class="title">{{title}}</h2>
        {{#description}}
        <p class="desc">{{description}}</p>
        {{/description}}
        <div class="meta">
          {{#author}}<span><strong>Author:</strong> {{author}}</span><br/>{{/author}}
          {{#publishDate}}<span><strong>Date:</strong> {{publishDate}}</span><br/>{{/publishDate}}
          {{#readTime}}<span><strong>Read:</strong> {{readTime}}</span><br/>{{/readTime}}
          {{#tag}}<span><strong>Tag:</strong> {{tag}}</span><br/>{{/tag}}
          {{#category}}<span><strong>Category:</strong> {{category}}</span><br/>{{/category}}
          <span class="tagline">Path: {{path}}</span>
        </div>
      </div>
    </a>
    {{/data}}
  </div>
</body>
</html>
